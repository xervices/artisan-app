# These variables should be set your EAS project
# Then run `eas env:pull development` to generate the .env.local file that looks like this

APP_ENV=development
EXPO_PUBLIC_API_URL=https://development.api
EXPO_PUBLIC_SENTRY_DSN=
# Needed at build time only, for uploading source maps (set as secret EAS env vars):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=